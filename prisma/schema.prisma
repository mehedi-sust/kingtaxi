// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  engineType = "library"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(cuid())
  firstName   String
  lastName    String
  email       String      @unique
  password    String?
  mobile      String?
  accountType AccountType @default(PERSONAL)
  message     String?
  isApproved  Boolean     @default(false)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("users")
}

model DriverApplication {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  mobile      String
  address     String
  experience  String
  message     String?
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("driver_applications")
}

model Offer {
  id          String   @id @default(cuid())
  title       String
  description String
  discount    Float
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("offers")
}

model CarImage {
  id          String   @id @default(cuid())
  url         String
  alt         String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("car_images")
}

model Review {
  id         String   @id @default(cuid())
  name       String
  rating     Int      @default(5)
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("reviews")
}

enum AccountType {
  PERSONAL
  BUSINESS
}
